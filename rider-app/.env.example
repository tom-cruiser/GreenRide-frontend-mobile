# Copy to .env and adjust for your environment.
# For physical device testing, use your computer's LAN IP (same Wi-Fi as the phone).
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000

# Map (Android, MapLibre). One of these; see docs/MAPS_SETUP.md.
# Development builds fall back to the public OpenStreetMap tiles (light testing only).
# EXPO_PUBLIC_MAP_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_KEY
# EXPO_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
